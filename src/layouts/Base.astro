---
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/bricolage-grotesque/800.css';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  seccion?: 'figuras' | 'pokemon' | 'videojuegos' | 'regalos';
}

const { titulo, descripcion, seccion } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const tituloCompleto = titulo === 'Botín Friki' ? titulo : `${titulo} · Botín Friki`;

const menu = [
  { id: 'figuras', texto: 'Figuras anime', href: '/es/figuras/' },
  { id: 'pokemon', texto: 'Pokémon', href: '/es/pokemon/' },
  { id: 'videojuegos', texto: 'Videojuegos', href: '/es/videojuegos/' },
  { id: 'regalos', texto: 'Regalos', href: '/es/regalos/' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_ES" />
    <meta name="color-scheme" content="light dark" />
    <script src="/js/tema.js" is:inline></script>
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <header class="cabecera">
      <div class="contenedor">
        <a class="logo" href="/es/">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v9H3z" fill="#F2A93B"/><path d="M3 12h18"/><rect x="10" y="10" width="4" height="5" rx="1" fill="#FFFFFF"/><path d="M8 3l1 2M16 3l-1 2M12 2v2"/></svg>
          Botín Friki
        </a>
        <nav class="nav" aria-label="Principal">
          <ul>
            {menu.map((item) => (
              <li><a href={item.href} aria-current={seccion === item.id ? 'page' : undefined}>{item.texto}</a></li>
            ))}
          </ul>
        </nav>
        <div class="herramientas">
          <form class="busqueda-mini" role="search" action="/es/buscar/" method="get">
            <label for="busca-cabecera" class="visualmente-oculto">Buscar en Botín Friki</label>
            <input id="busca-cabecera" name="q" type="search" placeholder="Serie o personaje" autocomplete="off" />
            <button class="boton-icono lleno" type="submit" aria-label="Buscar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </button>
          </form>
          <button id="boton-tema" class="boton-icono" type="button" aria-pressed="false" aria-label="Cambiar a modo oscuro">
            <svg class="icono-luna" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="icono-sol" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="contenido" data-pagefind-body>
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor">
        <p>En calidad de Afiliado de Amazon, obtengo ingresos por las compras adscritas que cumplen los requisitos aplicables.</p>
        <p>Las marcas y personajes mencionados pertenecen a sus respectivos propietarios. Botín Friki no vende ni envía productos.</p>
        <nav aria-label="Legal">
          <ul>
            <li><a href="/es/aviso-legal/">Aviso legal</a></li>
            <li><a href="/es/privacidad/">Privacidad</a></li>
            <li><a href="/es/como-elegimos/">Cómo elegimos</a></li>
            <li><a href="/es/accesibilidad/">Accesibilidad</a></li>
            <li><a href="/es/apoyar/">Apoyar el proyecto</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
