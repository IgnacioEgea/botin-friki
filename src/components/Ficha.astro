---
interface Props {
  nombre: string;
  linea: string;
  marca?: string;
  serie: string;
  tamano: string;
  nota: string;
  fuente?: string;
  url: string | null;
}

const { nombre, linea, marca = 'Banpresto', serie, tamano, nota, fuente, url } = Astro.props;
---
<article class="ficha panel sombra-s">
  <div class="ficha-imagen">Imagen pendiente</div>
  <div class="ficha-texto">
    <h4 class="ficha-nombre">{nombre}</h4>
    <div class="meta">{serie} · {linea} · {marca}</div>
    <div class="ficha-nota">{tamano}. {nota}</div>
    {fuente && <a class="ficha-fuente" href={fuente} rel="noopener" target="_blank">Ver el anuncio<span class="visualmente-oculto"> de {nombre} (se abre en una pestaña nueva)</span></a>}
  </div>
  <div class="ficha-accion">
    {url ? (
      <>
        <a class="boton boton-acento boton-pequeno" href={url} rel="sponsored noopener" target="_blank">Ver en Amazon<span class="visualmente-oculto"> (se abre en una pestaña nueva)</span></a>
        <div class="ficha-afiliado">Enlace de afiliado</div>
      </>
    ) : (
      <span class="boton-apagado">Enlace disponible pronto</span>
    )}
  </div>
</article>
